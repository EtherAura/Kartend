# Reproduces the GitHub Actions CI build environment locally.
#
# CI runs on ubuntu-24.04 runners, whose `qt6-base-dev` is Qt 6.4.2 — the
# project's KARTEND_MIN_QT_VERSION. A developer machine with a newer Qt
# silently accepts Qt 6.5+ APIs that then fail the CI build. Building inside
# this image catches that class of mismatch before pushing.
#
# Usage:
#   docker build -f .scripts/Dockerfile.ci -t kartend-ci .
#   # build + tests (mirrors the `build` job):
#   docker run --rm -v "$PWD":/src:ro kartend-ci \
#     bash -c 'cmake -S /src -B /tmp/b -G Ninja -DCMAKE_BUILD_TYPE=Release \
#                    -DKARTEND_BUILD_TESTS=ON && cmake --build /tmp/b --parallel'
#   # maintenance-check job:
#   docker run --rm -v "$PWD":/src kartend-ci \
#     bash -c 'cd /src && .scripts/build.sh --maintenance --format-check'
#   # thread-sanitizer job (pulseaudio is needed or QtMultimedia tests SIGILL).
#   # CAVEAT: containers share the HOST kernel, and TSan's runtime is
#   # kernel-sensitive — on a bleeding-edge host kernel (observed on 7.0,
#   # Kartend-t9u0o) every binary reports an instant bogus vptr race at
#   # startup, with or without ASLR. If a known-green commit fails like that
#   # here, distrust the host: verify via `gh workflow run nightly-tsan.yml
#   # --ref <branch>` on the real runner instead.
#   docker run --rm -v "$PWD":/src kartend-ci bash -c 'cd /src \
#     && pulseaudio --start --exit-idle-time=-1 && rm -rf build/TSan \
#     && cmake -S . -B build/TSan -G Ninja -DCMAKE_BUILD_TYPE=Debug \
#              -DKARTEND_BUILD_TESTS=ON -DKARTEND_ENABLE_TSAN=ON \
#     && cmake --build build/TSan --parallel \
#     && QT_QPA_PLATFORM=offscreen \
#        TSAN_OPTIONS=halt_on_error=1:suppressions=$PWD/tests/suppressions/tsan.txt \
#        ctest --test-dir build/TSan --output-on-failure'
FROM ubuntu:24.04

# libclang-rt-18-dev: clang's static sanitizer runtimes
# (libclang_rt.tsan-x86_64.a etc.) — without it the thread-sanitizer repro
# fails at link; libtsan2/libasan8 only cover gcc's shared runtimes.
#
# llvm-18: ships llvm-symbolizer, which clang's sanitizer runtimes need to
# turn a stack frame into file:line (Kartend-viynx). Without it a clang-built
# ASan/TSan repro prints "invalid path to external symbolizer!" and then
# address-only frames — useless next to the same failure on real CI, whose
# ubuntu-24.04 image has the symbolizer. The gap hid for a long time because
# GCC-built sanitizer binaries in this image DO symbolize (gcc falls back to
# addr2line from binutils), so only the clang paths are affected — and the
# thread-sanitizer job is the clang one. ~117 MB, which is the price of a
# readable TSan trace.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      clang g++ libtsan2 libasan8 libubsan1 libclang-rt-18-dev llvm-18 \
      cmake ninja-build lld ccache git python3 pulseaudio \
      `# unzip/p7zip-full EXTRACT archives; zip CREATES them (Kartend-nyy6l).` \
      `# Five test files shell out to the zip binary to build their fixture` \
      `# archives — romhasher, datpackimport, nointrodownloader, datlookup and` \
      `# launchmanager. Without it romhasher and launchmanager QFAIL under` \
      `# KARTEND_REQUIRE_ARCHIVE_TOOLS=1 (the flag CI's build/sanitizers jobs` \
      `# set, so a local repro that matches CI got 4 bogus failures), and the` \
      `# other three QSKIP in SILENCE — the container was quietly testing less` \
      `# than CI does. GitHub's ubuntu-24.04 image ships zip, which is why real` \
      `# CI never noticed.` \
      unzip zip p7zip-full \
      qt6-base-dev qt6-multimedia-dev qt6-tools-dev qt6-image-formats-plugins libqt6sql6-sqlite libzstd-dev \
      libarchive-dev qtkeychain-qt6-dev \
      `# libsdl2-dev: SDL2 is the primary Linux gamepad backend; installing it` \
      `# keeps that path compiling in container repros, matching the CI cell` \
      `# that carries it (build Release+gcc).` \
      libsdl2-dev \
      clang-tidy clang-format-19 cppcheck iwyu jq \
 `# clang-format pin (19) is owned by .scripts/lib/clang-format-version.sh;` \
 `# build.yml's "Verify pinned clang-format version" step fails CI if this` \
 `# literal drifts from that source of truth (Kartend-gv2xq).` \
 && ln -sf /usr/bin/clang-format-19 /usr/local/bin/clang-format \
 `# llvm-18 installs /usr/lib/llvm-18/bin/llvm-symbolizer and` \
 `# /usr/bin/llvm-symbolizer-18, but NOT a plain "llvm-symbolizer" on PATH —` \
 `# which is the exact name the sanitizer runtimes look for. The symlink is` \
 `# what actually fixes the traces; installing the package alone does not.` \
 && ln -sf /usr/lib/llvm-18/bin/llvm-symbolizer /usr/local/bin/llvm-symbolizer \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
