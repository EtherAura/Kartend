# Cross-compile Kartend from Linux to Windows (MinGW-w64 + Qt6).
#
# Backs .scripts/build-windows-cross.sh. Fedora 41 is the base because it
# ships a comprehensive mingw64-qt6-* package set; MXE-style alternatives
# require building Qt from source (1–3 hours), and other distros' MinGW
# packages don't cover Qt6 well as of this writing.
#
# Toolchain pinned at apt-side:
#   * mingw64-gcc-c++ 14.x  (POSIX threading model — Qt requires it)
#   * mingw64-qt6-* 6.8.x   (current Fedora Qt6 cross series)
#   * mingw64-zstd, mingw64-SDL2 — optional kartend backends
#
# Caveats:
#   * No mingw64-qt6-qtkeychain package on Fedora (only mingw64-qtkeychain
#     for Qt5). The resulting kartend.exe falls back to the plaintext-INI
#     scraper credential path, which is the same behaviour as a Linux build
#     without qtkeychain-qt6-dev installed.
#   * This image targets MinGW-GCC, NOT MSVC. The release pipeline uses
#     MSVC via CI (build.yml's windows-preview-build job). Use this image
#     for fast Windows-portability iteration locally without the CI
#     round-trip.
#
# Build:  docker build -t kartend-windows-cross -f .scripts/Dockerfile.windows-cross .scripts/
# (the .scripts/ build context is intentionally tiny — no source tree)

FROM fedora:41

RUN dnf install -y --setopt=install_weak_deps=False \
      mingw64-filesystem \
      mingw64-gcc-c++ \
      mingw64-binutils \
      mingw64-winpthreads \
      mingw64-qt6-qtbase \
      mingw64-qt6-qtmultimedia \
      mingw64-qt6-qttools \
      mingw64-qt6-qttranslations \
      mingw64-qt6-qtsvg \
      mingw64-qt6-qtimageformats \
      mingw64-zstd \
      mingw64-SDL2 \
      ninja-build \
      cmake \
      file \
      zip \
 && dnf clean all

WORKDIR /src
