# Clang-Tidy Configuration for Kartend
# Focuses on actionable warnings, disabling noisy style checks

# Start with all checks disabled, then enable specific categories
Checks: "-*,clang-analyzer-*,bugprone-*,performance-*,modernize-*,readability-*,misc-*,-modernize-use-trailing-return-type,-modernize-use-designated-initializers,-modernize-use-nodiscard,-modernize-return-braced-init-list,-modernize-use-ranges,-readability-implicit-bool-conversion,-readability-identifier-length,-readability-magic-numbers,-readability-braces-around-statements,-readability-else-after-return,-readability-named-parameter,-readability-uppercase-literal-suffix,-readability-redundant-access-specifiers,-readability-simplify-boolean-expr,-readability-identifier-naming,-readability-math-missing-parentheses,-readability-use-std-min-max,-readability-function-cognitive-complexity,-readability-static-definition-in-anonymous-namespace,-readability-convert-member-functions-to-static,-readability-function-size,-performance-enum-size,-performance-avoid-endl,-performance-no-automatic-move,-misc-non-private-member-variables-in-classes,-misc-const-correctness,-misc-use-anonymous-namespace,-misc-include-cleaner,-misc-no-recursion,-misc-use-internal-linkage,-bugprone-easily-swappable-parameters,-bugprone-branch-clone,-bugprone-narrowing-conversions,-bugprone-macro-parentheses,-bugprone-implicit-widening-of-multiplication-result"

# Only analyze project headers, not Qt or system headers
HeaderFilterRegex: '.*/src/.*'

# Warnings as errors for specific critical checks. Each subcheck listed here
# has been verified to have ZERO findings in the current baseline so a
# regression triggers the maintenance CI gate.
#
# Promotion criteria: bugprone-* / clang-analyzer-* subchecks where the
# findings are real correctness/safety issues (not stylistic). Add new
# entries only after running `.scripts/build.sh --maintenance` and
# confirming the subcheck reports zero hits in build/ninja-maintenance/
# logs/clang-tidy.log.
#
# clang-analyzer-* notes:
#  - core/cplusplus/deadcode/security/unix verified zero on current tree.
#  - optin.* (notably optin.performance.Padding) deliberately excluded —
#    256 stylistic struct-padding hits, opt-in for a reason; not promotion
#    material.
#  - osx.* not relevant.
#  - clang-analyzer-cplusplus.NewDelete excluded: path-sensitive UAF
#    detection follows our QSharedPointer / std::shared_ptr usage into
#    /usr/include/.../qsharedpointer_impl.h:130 and reports a false-
#    positive UAF inside Qt's own implementation. HeaderFilterRegex would
#    normally hide that, but cross-TU clang-analyzer reports at the
#    deallocation site (Qt header), not the trigger (our code), so the
#    filter doesn't apply.
#  - clang-analyzer-cplusplus.NewDeleteLeaks similarly excluded: produces
#    "Potential memory leak" reports inside qobjectdefs.h:319 (the
#    QMetaMethod::invoke template family) when our code uses
#    QMetaObject::invokeMethod with a heap-allocated argument tuple.
#    Qt manages those allocations through its own mechanism that the
#    analyzer can't model.
#  - clang-analyzer-core.CallAndMessage excluded: noisy on lambdas captured
#    by QtConcurrent::run / blockingMap — the analyzer flags reads of
#    `this->m_member` inside the worker lambda as "called on null",
#    presumably because it can't prove the lambda's `this` is the same
#    object across the thread boundary. Real null-deref bugs would be
#    caught by core.NullDereference, which we keep.
#  - Remaining promoted subchecks (PlacementNew, PureVirtualCall,
#    SelfAssignment, StringChecker, all of core minus CallAndMessage)
#    have zero hits in the current baseline.
#
# bugprone-* / performance-* additions: a one-off scan with `clang-tidy
# --checks="-*,bugprone-*,performance-*,cert-*"` over every src/*.cpp on
# the current tree returned hits ONLY for: bugprone-incorrect-roundings,
# bugprone-bool-pointer-implicit-conversion, performance-unnecessary-
# value-param, performance-unnecessary-copy-initialization, performance-
# implicit-conversion-in-loop, cert-err33-c, cert-err58-cpp. Everything
# else in those check families had zero hits. The subset promoted below
# was chosen from the zero-hit list as "real correctness/safety bugs
# with very low false-positive rates" — narrow checks with a clear
# fail-loud pattern. Aggressive checks like bugprone-easily-swappable-
# parameters, exception-escape, unsafe-functions remain unpromoted to
# avoid foot-guns.
WarningsAsErrors: 'bugprone-unchecked-optional-access,bugprone-integer-division,bugprone-assignment-in-if-condition,bugprone-chained-comparison,bugprone-dangling-handle,bugprone-fold-init-type,bugprone-inaccurate-erase,bugprone-multiple-new-in-one-expression,bugprone-shared-ptr-array-mismatch,bugprone-sizeof-container,bugprone-sizeof-expression,bugprone-string-constructor,bugprone-suspicious-memory-comparison,bugprone-suspicious-memset-usage,bugprone-suspicious-semicolon,bugprone-swapped-arguments,bugprone-throw-keyword-missing,bugprone-undefined-memory-manipulation,bugprone-unique-ptr-array-mismatch,bugprone-unused-raii,bugprone-use-after-move,bugprone-virtual-near-miss,performance-move-const-arg,performance-noexcept-destructor,performance-noexcept-move-constructor,clang-analyzer-core.NullDereference,clang-analyzer-core.DivideZero,clang-analyzer-core.UndefinedBinaryOperatorResult,clang-analyzer-core.uninitialized.*,clang-analyzer-core.StackAddressEscape,clang-analyzer-cplusplus.PlacementNew,clang-analyzer-cplusplus.PureVirtualCall,clang-analyzer-cplusplus.SelfAssignment,clang-analyzer-cplusplus.StringChecker,clang-analyzer-deadcode.*,clang-analyzer-security.*,clang-analyzer-unix.*'

# Apply fixes when running with --fix (conservative)
FormatStyle: 'file'
