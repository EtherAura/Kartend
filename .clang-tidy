# Clang-Tidy Configuration for Kartend
# Focuses on actionable warnings, disabling noisy style checks.
#
# Quarterly review note: scan the disabled-check list below and try
# re-enabling one or two each quarter. Project hygiene improves over time
# and what was noisy six months ago may be tractable now. The exclusions
# should NOT be considered permanent.
#
# Rationale for each disabled check (grouped by family):
#
# modernize-*:
#   -modernize-use-trailing-return-type       — stylistic, codebase prefers leading return type
#   -modernize-use-designated-initializers    — Qt structs predate C99-style designated init
#   -modernize-use-nodiscard                  — [[nodiscard]] only on getters/factories by convention
#   -modernize-return-braced-init-list        — readability tradeoff with explicit type
#   -modernize-use-ranges                     — BLOCKED on a toolchain bump, not
#                                               just Qt. 2026-07 review: the CI
#                                               container's clang-tidy is LLVM
#                                               18.1.3, and modernize-use-ranges
#                                               was only introduced in clang-tidy
#                                               20, so it does not exist on the
#                                               current CI at all (an all-src pass
#                                               "found 0" only because the check
#                                               name is unknown there). Re-enable
#                                               once CI's clang-tidy reaches >= 20,
#                                               then verify its auto-rewrites are
#                                               sound on the pinned Qt (std::ranges
#                                               conformance was only partial on
#                                               6.4) before applying fixes.
#
# readability-*:
#   -readability-implicit-bool-conversion     — project rule: implicit-null is preferred
#   -readability-identifier-length            — single-char loop vars / template params are fine
#   -readability-magic-numbers                — src/utils/uiconstants/* covers high-traffic numbers; the rest is noise
#   -readability-braces-around-statements     — short single-line if/while are idiomatic Qt
#   -readability-else-after-return            — stylistic
#   -readability-named-parameter              — overrides with unused params are fine
#   -readability-uppercase-literal-suffix     — Qt headers leak lowercase l/L suffixes
#   -readability-redundant-access-specifiers  — Qt MOC sometimes inserts extras
#   -readability-simplify-boolean-expr        — codebase prefers explicit forms in conditional chains
#   -readability-identifier-naming            — Qt naming (m_ prefix, camelCase methods) clashes with most lint configurations
#   -readability-math-missing-parentheses     — overly cautious on idiomatic expressions
#   -readability-use-std-min-max              — qBound/qMin/qMax are fine in Qt code
#   -readability-function-cognitive-complexity — many legit "switch on enum" functions trip it
#   -readability-static-definition-in-anonymous-namespace — anonymous namespaces are the canonical static replacement here
#   -readability-convert-member-functions-to-static — many slot-like methods stay member for signal/slot connection
#   -readability-function-size                — long functions in dialog setup are intentional
#
# performance-*:
#   -performance-enum-size                    — Qt enums often use int by API contract
#   -performance-avoid-endl                   — qDebug() endl is wired into Qt logging
#   -performance-no-automatic-move            — false positives on Qt copy-on-write containers
#
# misc-*:
#   -misc-non-private-member-variables-in-classes — Qt UI generated classes have public members
#   -misc-const-correctness                   — too noisy on Qt's many non-const slot signatures
#   -misc-use-anonymous-namespace             — codebase mixes file-static and anonymous-namespace
#   -misc-include-cleaner                     — Qt umbrella headers like <QtWidgets> are intentional
#   -misc-no-recursion                        — recursive helpers (collection tree walks) are correct
#   -misc-use-internal-linkage                — same as anonymous-namespace; the codebase mixes styles
#
# bugprone-* (the noisy ones):
#   -bugprone-easily-swappable-parameters     — too aggressive for Qt's parameter conventions
#   -bugprone-branch-clone                    — duplicate branches in switch are often intentional
#   -bugprone-narrowing-conversions           — Qt's int↔qsizetype churn would flood the report
#   -bugprone-macro-parentheses               — debugLog() macros need to remain unparenthesised
#   -bugprone-implicit-widening-of-multiplication-result — int*int into qint64 is the common pattern

# Start with all checks disabled, then enable specific categories
Checks: "-*,clang-analyzer-*,bugprone-*,performance-*,modernize-*,readability-*,misc-*,-modernize-use-trailing-return-type,-modernize-use-designated-initializers,-modernize-use-nodiscard,-modernize-return-braced-init-list,-modernize-use-ranges,-readability-implicit-bool-conversion,-readability-identifier-length,-readability-magic-numbers,-readability-braces-around-statements,-readability-else-after-return,-readability-named-parameter,-readability-uppercase-literal-suffix,-readability-redundant-access-specifiers,-readability-simplify-boolean-expr,-readability-identifier-naming,-readability-math-missing-parentheses,-readability-use-std-min-max,-readability-function-cognitive-complexity,-readability-static-definition-in-anonymous-namespace,-readability-convert-member-functions-to-static,-readability-function-size,-performance-enum-size,-performance-avoid-endl,-performance-no-automatic-move,-misc-non-private-member-variables-in-classes,-misc-const-correctness,-misc-use-anonymous-namespace,-misc-include-cleaner,-misc-no-recursion,-misc-use-internal-linkage,-bugprone-easily-swappable-parameters,-bugprone-branch-clone,-bugprone-narrowing-conversions,-bugprone-macro-parentheses,-bugprone-implicit-widening-of-multiplication-result"

# Only analyze project headers, not Qt or system headers
HeaderFilterRegex: '.*/src/.*'

# Warnings as errors for specific critical checks. Each subcheck listed here
# has been verified to have ZERO findings in the current baseline so a
# regression triggers the maintenance CI gate.
#
# Promotion criteria: bugprone-* / clang-analyzer-* subchecks where the
# findings are real correctness/safety issues (not stylistic). Add new
# entries only after running `.scripts/build.sh --maintenance` and
# confirming the subcheck reports zero hits in build/ninja-maintenance/
# logs/clang-tidy.log.
#
# clang-analyzer-* notes:
#  - core/cplusplus/deadcode/security/unix verified zero on current tree.
#  - optin.* (notably optin.performance.Padding) deliberately excluded —
#    256 stylistic struct-padding hits, opt-in for a reason; not promotion
#    material.
#  - osx.* not relevant.
#  - clang-analyzer-cplusplus.NewDelete excluded: path-sensitive UAF
#    detection follows our QSharedPointer / std::shared_ptr usage into
#    /usr/include/.../qsharedpointer_impl.h:130 and reports a false-
#    positive UAF inside Qt's own implementation. HeaderFilterRegex would
#    normally hide that, but cross-TU clang-analyzer reports at the
#    deallocation site (Qt header), not the trigger (our code), so the
#    filter doesn't apply.
#  - clang-analyzer-cplusplus.NewDeleteLeaks similarly excluded: produces
#    "Potential memory leak" reports inside qobjectdefs.h:319 (the
#    QMetaMethod::invoke template family) when our code uses
#    QMetaObject::invokeMethod with a heap-allocated argument tuple.
#    Qt manages those allocations through its own mechanism that the
#    analyzer can't model.
#  - clang-analyzer-core.CallAndMessage excluded: noisy on lambdas captured
#    by QtConcurrent::run / blockingMap — the analyzer flags reads of
#    `this->m_member` inside the worker lambda as "called on null",
#    presumably because it can't prove the lambda's `this` is the same
#    object across the thread boundary. Real null-deref bugs would be
#    caught by core.NullDereference, which we keep.
#  - Remaining promoted subchecks (PlacementNew, PureVirtualCall,
#    SelfAssignment, StringChecker, all of core minus CallAndMessage)
#    have zero hits in the current baseline.
#
# bugprone-* / performance-* additions: a one-off scan with `clang-tidy
# --checks="-*,bugprone-*,performance-*,cert-*"` over every src/*.cpp on
# the current tree returned hits ONLY for: bugprone-incorrect-roundings,
# bugprone-bool-pointer-implicit-conversion, performance-unnecessary-
# value-param, performance-unnecessary-copy-initialization, performance-
# implicit-conversion-in-loop, cert-err33-c, cert-err58-cpp. Everything
# else in those check families had zero hits. The bugprone/cert subset
# promoted below was chosen from the zero-hit list as "real correctness/
# safety bugs with very low false-positive rates" — narrow checks with a
# clear fail-loud pattern. The three performance-* checks above
# (unnecessary-value-param, unnecessary-copy-initialization, implicit-
# conversion-in-loop) had a finite hit set that has since been fixed, so
# they are now promoted too — the only carve-outs are the two
# MetadataLookupProvider virtuals whose overrides std::move the callback
# (const-ref there would pessimize the move), which carry an inline
# NOLINT. Aggressive checks like bugprone-easily-swappable-parameters,
# exception-escape, unsafe-functions remain unpromoted to avoid foot-guns.
WarningsAsErrors: 'bugprone-unchecked-optional-access,bugprone-integer-division,bugprone-assignment-in-if-condition,bugprone-chained-comparison,bugprone-dangling-handle,bugprone-fold-init-type,bugprone-inaccurate-erase,bugprone-multiple-new-in-one-expression,bugprone-shared-ptr-array-mismatch,bugprone-sizeof-container,bugprone-sizeof-expression,bugprone-string-constructor,bugprone-suspicious-memory-comparison,bugprone-suspicious-memset-usage,bugprone-suspicious-semicolon,bugprone-swapped-arguments,bugprone-throw-keyword-missing,bugprone-undefined-memory-manipulation,bugprone-unique-ptr-array-mismatch,bugprone-unused-raii,bugprone-use-after-move,bugprone-virtual-near-miss,performance-move-const-arg,performance-noexcept-destructor,performance-noexcept-move-constructor,performance-unnecessary-value-param,performance-unnecessary-copy-initialization,performance-implicit-conversion-in-loop,clang-analyzer-core.NullDereference,clang-analyzer-core.DivideZero,clang-analyzer-core.UndefinedBinaryOperatorResult,clang-analyzer-core.uninitialized.*,clang-analyzer-core.StackAddressEscape,clang-analyzer-cplusplus.PlacementNew,clang-analyzer-cplusplus.PureVirtualCall,clang-analyzer-cplusplus.SelfAssignment,clang-analyzer-cplusplus.StringChecker,clang-analyzer-deadcode.*,clang-analyzer-security.*,clang-analyzer-unix.*'

# Apply fixes when running with --fix (conservative)
FormatStyle: 'file'
