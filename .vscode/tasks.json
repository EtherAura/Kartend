{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (release)",
      "type": "shell",
      "command": "${workspaceFolder}/.scripts/build.sh",
      "args": [],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build + tests",
      "type": "shell",
      "command": "${workspaceFolder}/.scripts/build.sh",
      "args": ["--tests"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build + run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.scripts/build.sh",
      "args": ["--tests", "--run-tests"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "maintenance (format + lint + build)",
      "type": "shell",
      "command": "${workspaceFolder}/.scripts/build.sh",
      "args": ["--maintenance"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
