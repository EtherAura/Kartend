root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,cxx,hxx,cc}]
indent_size = 2
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
