# Maintainer: EtherAura <https://github.com/EtherAura>

pkgname=kartend
pkgver=0.0.19
pkgrel=1
pkgdesc='Qt6 KDE frontend for organizing and launching multimedia collections'
arch=('x86_64')
url='https://github.com/EtherAura/Kartend'
license=('GPL-3.0-only')
depends=(
  'gcc-libs'
  'glibc'
  'qt6-base'
  'qt6-multimedia'
  # qt6-gamepad was dropped from the Arch repos when QtGamepad was deprecated
  # upstream. The CMake build wraps it in `find_package(... QUIET)` and falls
  # back to the SDL2 gamepad backend, so listing it here just makes pacman
  # refuse the install. SDL2 is the working gamepad path on Arch.
  'sdl2'
  # The remaining optional backends CMake auto-detects at configure time
  # (cmake/OptionalBackends.cmake). Arch ships headers in the runtime
  # packages, so listing them here both links the feature in at build time
  # and keeps the shared library present at runtime: libzstd.so (Kart
  # compression), libarchive.so (in-process archive-member hashing), and
  # libqt6keychain.so (secret-service credential storage). Without them the
  # binary still builds but silently falls back to the degraded paths.
  'zstd'
  'libarchive'
  'qtkeychain-qt6'
)
makedepends=(
  'cmake'
  'ninja'
  # Provides Qt6LinguistTools (lupdate/lrelease + cmake module), which the
  # top-level CMakeLists.txt lists in QT_REQUIRED_COMPONENTS for .ts → .qm
  # translation compilation. Build-time only; runtime needs only qt6-base's
  # QTranslator for loading the compiled .qm files.
  'qt6-tools'
)
checkdepends=()
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/Kartend-${pkgver}.tar.gz")
# Verifying GitHub's auto-archive sha256 isn't reliable — its gzip parameters
# can change without notice. For v0.0.6+ this URL should switch to the release
# page asset (releases/download/vX.Y.Z/Kartend-X.Y.Z.tar.gz) published by
# .github/workflows/release.yml, at which point sha256sums can be filled in
# from the deterministic `git archive` output (see workflow's post-publish step).
sha256sums=('888bf063b98b29f847abca015620a551d8dde3ea1db9e190721e81b0c759a351')

build() {
  cmake -S "Kartend-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKARTEND_BUILD_TESTS=OFF \
    -DKARTEND_ENABLE_CCACHE=OFF \
    -DKARTEND_MAINTENANCE=OFF \
    -DKARTEND_PORTABLE_RELEASE=ON

  cmake --build build
}

check() {
  # Tests are opt-in at configure time; reconfigure with KARTEND_BUILD_TESTS=ON
  # in a sibling dir so the packaging build itself stays test-free.
  cmake -S "Kartend-${pkgver}" -B build-tests -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DKARTEND_BUILD_TESTS=ON \
    -DKARTEND_ENABLE_CCACHE=OFF \
    -DKARTEND_PORTABLE_RELEASE=ON
  cmake --build build-tests
  # offscreen: the GUI tests need a Qt platform but makepkg often runs
  # headless (chroot/clean builds have no display server). -LE benchmark
  # matches every CI ctest invocation — the QBENCHMARK suites are
  # timing-sensitive and excluded outside the dedicated benchmark job.
  QT_QPA_PLATFORM=offscreen ctest --test-dir build-tests --output-on-failure -LE benchmark
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  install -Dm644 "Kartend-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "Kartend-${pkgver}/readme.md" "${pkgdir}/usr/share/doc/${pkgname}/readme.md"
  cp -a "Kartend-${pkgver}/docs" "${pkgdir}/usr/share/doc/${pkgname}/"
}
