      <item row="2" column="0"><widget class="QLabel" name="label_fileExtensions"><property name="minimumSize"><size><width>200</width><height>0</height></size></property><property name="text"><string>File Extensions:</string></property></widget></item>
      <item row="2" column="1"><widget class="QLineEdit" name="fileExtensionsLineEdit"><property name="maximumWidth"><number>320</number></property><property name="toolTip"><string>Comma-separated list of file extensions to include</string></property></widget></item>
