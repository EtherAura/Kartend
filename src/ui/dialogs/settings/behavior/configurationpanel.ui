        <item row="0" column="0"><widget class="QLabel" name="label_datFiles"><property name="minimumSize"><size><width>200</width><height>0</height></size></property><property name="text"><string>DAT Files:</string></property></widget></item>
        <item row="0" column="1">
         <layout class="QVBoxLayout" name="datFilesLayout">
          <item>
           <widget class="QListWidget" name="datFilesListWidget">
            <property name="toolTip"><string>DAT files (No-Intro / Redump / TOSEC Logiqx XML, or MAME listxml). Walked top-to-bottom on every scrape — the first hash match wins. Drag rows to reorder. Empty list disables offline DAT lookup.</string></property>
            <property name="dragDropMode"><enum>QAbstractItemView::DragDropMode::InternalMove</enum></property>
            <property name="selectionMode"><enum>QAbstractItemView::SelectionMode::ExtendedSelection</enum></property>
            <property name="maximumSize"><size><width>16777215</width><height>120</height></size></property>
           </widget>
