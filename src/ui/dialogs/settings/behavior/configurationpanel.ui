      <item row="2" column="0"><widget class="QLabel" name="label_collectionType"><property name="minimumSize"><size><width>200</width><height>0</height></size></property><property name="text"><string>Media Type:</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QComboBox" name="collectionTypeComboBox">
        <property name="maximumWidth"><number>320</number></property>
        <property name="editable"><bool>true</bool></property>
        <property name="toolTip"><string>Free-form category label (e.g. Games, Movies, Music). Subcollections inherit the nearest tagged ancestor when left blank. The toolbar type filter shows only subcollection tiles whose effective type matches.</string></property>
       </widget>
      </item>
     </layout>
