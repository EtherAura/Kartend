    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="configBehaviorGroupBox">
     <property name="title"><string>Behavior</string></property>
     <layout class="QVBoxLayout" name="configBehaviorFormLayout">
      <property name="spacing"><number>6</number></property>
      <item><widget class="QCheckBox" name="expandModeCheckBox"><property name="text"><string>Expand mode (two-stage activation)</string></property><property name="toolTip"><string>Two-stage activation: first double-click or Enter expands the artwork preview; a second activation on the same item launches it.</string></property></widget></item>
      <item><widget class="QCheckBox" name="showAllSubcollectionItemsCheckBox"><property name="text"><string>Show all subcollection items together</string></property><property name="toolTip"><string>Mix items from subcollections with parent collection items, sorted alphabetically</string></property></widget></item>
      <item><widget class="QCheckBox" name="watchFilesystemCheckBox"><property name="text"><string>Watch filesystem for changes</string></property><property name="toolTip"><string>Automatically detect files added, removed, or renamed in the media directory and trigger an incremental rescan (debounced ~2 s). Disable for large network mounts where watching is expensive.</string></property></widget></item>
      <item><widget class="QCheckBox" name="groupMultiDiscCheckBox"><property name="text"><string>Group multi-disc releases into one item</string></property><property name="toolTip"><string>Files whose names differ only by a disc marker — (Disc 1), (CD 2), (Side A) — become a single item that plays every part in order, backed by a playlist Kartend generates. The playlist is kept in Kartend's own data directory, never written beside your files. Metadata is merged across the parts, with the first disc taking precedence. Turning this off brings the individual files back and leaves nothing behind. Changing it rescans the collection.</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="configScrapersGroupBox">
     <property name="title"><string>Scrapers</string></property>
     <layout class="QVBoxLayout" name="configScrapersOuterLayout">
      <property name="spacing"><number>6</number></property>
      <item>
       <layout class="QFormLayout" name="configScrapersFormLayout">
        <property name="horizontalSpacing"><number>16</number></property>
        <property name="verticalSpacing"><number>6</number></property>
        <property name="labelAlignment"><set>Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignVCenter</set></property>
        <property name="fieldGrowthPolicy"><enum>QFormLayout::FieldGrowthPolicy::FieldsStayAtSizeHint</enum></property>
        <item row="0" column="0"><widget class="QLabel" name="label_scraperProvider"><property name="minimumSize"><size><width>200</width><height>0</height></size></property><property name="text"><string>Metadata Scraper:</string></property></widget></item>
        <item row="0" column="1"><widget class="QComboBox" name="scraperProviderComboBox"><property name="maximumWidth"><number>320</number></property><property name="toolTip"><string>Metadata scraper for this collection. Automatic resolves a provider by matching the collection type; pick one explicitly to scrape a custom-typed collection.</string></property></widget></item>
        <item row="1" column="0"><widget class="QLabel" name="label_screenscraperSystem"><property name="minimumSize"><size><width>200</width><height>0</height></size></property><property name="text"><string>ScreenScraper System:</string></property></widget></item>
        <item row="1" column="1"><widget class="QComboBox" name="screenscraperSystemComboBox"><property name="maximumWidth"><number>320</number></property><property name="toolTip"><string>Override ScreenScraper.fr's per-collection system id. Leave on Auto-detect to let Kartend pick from the collection's name / type / extensions.</string></property></widget></item>
        <item row="2" column="0" colspan="2"><widget class="QCheckBox" name="screenscraperHashArchiveCheckBox"><property name="text"><string>Hash inner ROM in archives (ScreenScraper)</string></property><property name="toolTip"><string>When the scraped item is a .zip / .7z / etc., extract it and hash the inner ROM rather than the outer archive — much higher ScreenScraper match accuracy. Turn off to skip the extraction cost for huge archives.</string></property></widget></item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="screenscraperSystemHintLabel">
        <property name="wordWrap"><bool>true</bool></property>
        <property name="text"><string>The ScreenScraper system list will appear here after your first ScreenScraper scrape (configure credentials under Settings → Scrapers → ScreenScraper first, then right-click an item → Scrape with ScreenScraper.fr…). Until then only Auto-detect is available.</string></property>
        <property name="styleSheet"><string>color: palette(placeholder-text);</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="configDatFilesGroupBox">
     <property name="title"><string>DAT files</string></property>
     <property name="toolTip"><string>DAT catalogues for this collection. Used both to identify scraped items (offline hash lookup) and to audit the collection against a known set.</string></property>
     <layout class="QVBoxLayout" name="configDatFilesOuterLayout">
      <property name="spacing"><number>6</number></property>
