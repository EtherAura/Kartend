      <item row="4" column="0" colspan="2"><widget class="QCheckBox" name="runtimeDetectionCheckBox"><property name="text"><string>Track launched items (runtime detection)</string></property><property name="toolTip"><string>Track launched items so Kartend hides behind a &quot;Now Playing&quot; overlay while running and returns automatically when the program closes</string></property></widget></item>
