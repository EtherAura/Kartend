      <item row="2" column="1"><widget class="QSpinBox" name="historyMaxEntriesSpinBox"><property name="maximumWidth"><number>120</number></property><property name="toolTip"><string>After each launch, oldest entries above this count are deleted. Range: 10–50000.</string></property><property name="minimum"><number>10</number></property><property name="maximum"><number>50000</number></property><property name="singleStep"><number>50</number></property><property name="value"><number>500</number></property></widget></item>
