   <item>
    <widget class="QGroupBox" name="navigationSidebarGroup">
     <property name="title"><string>Navigation sidebar (collection tree)</string></property>
     <layout class="QFormLayout" name="navigationSidebarForm">
      <item row="0" column="0"><widget class="QLabel" name="treeSideLabel"><property name="text"><string>Side:</string></property></widget></item>
      <item row="0" column="1">
       <widget class="QComboBox" name="treeSideComboBox">
        <property name="toolTip"><string>Same setting as View → Collection Tree Position.</string></property>
        <item><property name="text"><string>Left</string></property></item>
        <item><property name="text"><string>Right</string></property></item>
       </widget>
      </item>
      <item row="1" column="0"><widget class="QLabel" name="treeModeLabel"><property name="text"><string>Mode:</string></property></widget></item>
      <item row="1" column="1">
       <widget class="QComboBox" name="treeModeComboBox">
        <property name="toolTip"><string>Overlap floats the navigation sidebar above the content, so opening or resizing it never moves the grid underneath — it simply covers it. Push aside keeps the classic behaviour, where the sidebar takes its width from the content area and the grid shifts to make room.</string></property>
        <item><property name="text"><string>Overlap the content</string></property></item>
        <item><property name="text"><string>Push the content aside</string></property></item>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel" name="treeJustificationLabel"><property name="text"><string>Justification:</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QComboBox" name="treeJustificationComboBox">
        <property name="toolTip"><string>Full height makes the tree span the whole window, with the toolbar stopping at its edge.</string></property>
        <item><property name="text"><string>Below toolbar</string></property></item>
        <item><property name="text"><string>Full height</string></property></item>
       </widget>
      </item>
      <item row="3" column="0"><widget class="QLabel" name="treeWidthLabel"><property name="text"><string>Width:</string></property></widget></item><item row="3" column="1"><widget class="QSpinBox" name="treeWidthSpinBox"><property name="toolTip"><string>Width of the navigation sidebar in pixels. You can also drag the panel&apos;s inner edge.</string></property><property name="minimum"><number>140</number></property><property name="maximum"><number>600</number></property><property name="value"><number>240</number></property><property name="suffix"><string> px</string></property></widget></item><item row="4" column="0"><widget class="QLabel" name="treeHideScrollbarLabel"><property name="text"><string>Scrollbar:</string></property></widget></item>
      <item row="4" column="1">
       <widget class="QComboBox" name="treeScrollbarModeComboBox"><property name="toolTip"><string>Show: normal. Auto-hide: appears only when the pointer comes near the scrollbar edge. Hide: never drawn. The tree always scrolls with the wheel and the arrow keys — this only governs the indicator. Auto-hide needs slim overlay scrollbars (Settings -&gt; General); without them it behaves as Show.</string></property><item><property name="text"><string>Show</string></property></item><item><property name="text"><string>Auto-hide (show near the edge)</string></property></item><item><property name="text"><string>Hide</string></property></item></widget>
      </item>
      <item row="5" column="0"><widget class="QLabel" name="treeIconDisplayLabel"><property name="text"><string>Rows show:</string></property></widget></item>
      <item row="5" column="1">
       <widget class="QComboBox" name="treeIconDisplayComboBox">
        <property name="toolTip"><string>What a row shows when it has an icon or logo. Name only: the artwork is kept but not drawn. Icon and name: a small icon beside the name. Icon only: just the artwork, with the name in the tooltip. Rows without artwork always show their name.</string></property>
        <item><property name="text"><string>Name only</string></property></item>
        <item><property name="text"><string>Icon and name</string></property></item>
        <item><property name="text"><string>Icon only (name in tooltip)</string></property></item>
       </widget>
      </item>
      <item row="6" column="0"><widget class="QLabel" name="treeShowLinesLabel"><property name="text"><string>Tree lines:</string></property></widget></item>
      <item row="6" column="1">
       <widget class="QCheckBox" name="treeShowLinesCheckBox">
        <property name="toolTip"><string>Draw the connector lines between branches. The expand/collapse chevrons show either way.</string></property>
        <property name="text"><string>Show branch connector lines</string></property>
       </widget>
      </item>
      <item row="7" column="0"><widget class="QLabel" name="treeIconSizeLabel"><property name="text"><string>Icon height:</string></property></widget></item>
      <item row="7" column="1">
       <widget class="QSpinBox" name="treeIconSizeSpinBox">
