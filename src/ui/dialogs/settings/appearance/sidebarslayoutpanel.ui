       <widget class="QComboBox" name="paneJustificationComboBox">
        <property name="toolTip"><string>Full height makes the pane span the whole window, with the toolbar stopping at its edge. Applies to Left/Right docks; Top/Bottom and Overlay ignore it.</string></property>
