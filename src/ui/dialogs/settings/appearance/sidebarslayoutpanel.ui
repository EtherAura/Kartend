<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SidebarsLayoutPanel</class>
 <widget class="QWidget" name="SidebarsLayoutPanel">
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <widget class="QGroupBox" name="detailsPaneGroup">
     <property name="title"><string>Details pane</string></property>
     <layout class="QFormLayout" name="detailsPaneForm">
      <item row="0" column="0"><widget class="QLabel" name="paneSideLabel"><property name="text"><string>Side:</string></property></widget></item>
      <item row="0" column="1">
       <widget class="QComboBox" name="paneSideComboBox">
        <property name="toolTip"><string>Same setting as Position on the Details Pane page — the two controls stay in sync.</string></property>
        <item><property name="text"><string>Right</string></property></item>
        <item><property name="text"><string>Left</string></property></item>
        <item><property name="text"><string>Top</string></property></item>
        <item><property name="text"><string>Bottom</string></property></item>
       </widget>
      </item>
      <item row="1" column="0"><widget class="QLabel" name="paneJustificationLabel"><property name="text"><string>Justification:</string></property></widget></item>
      <item row="1" column="1">
       <widget class="QComboBox" name="paneJustificationComboBox">
        <property name="toolTip"><string>Full height makes the pane span the whole window, with the toolbar stopping at its edge. Applies to Left/Right docks; Top/Bottom and Overlay ignore it.</string></property>
        <item><property name="text"><string>Below toolbar</string></property></item>
        <item><property name="text"><string>Full height</string></property></item>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel" name="paneHideScrollbarLabel"><property name="text"><string>Scrollbar:</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QComboBox" name="paneScrollbarModeComboBox"><property name="toolTip"><string>Show: normal. Auto-hide: appears only when the pointer comes near the scrollbar edge. Hide: never drawn. The pane always scrolls with the wheel — this only governs the indicator. Auto-hide needs slim overlay scrollbars (Settings -&gt; General); without them it behaves as Show.</string></property><item><property name="text"><string>Show</string></property></item><item><property name="text"><string>Auto-hide (show near the edge)</string></property></item><item><property name="text"><string>Hide</string></property></item></widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="navigationSidebarGroup">
     <property name="title"><string>Navigation sidebar (collection tree)</string></property>
     <layout class="QFormLayout" name="navigationSidebarForm">
      <item row="0" column="0"><widget class="QLabel" name="treeSideLabel"><property name="text"><string>Side:</string></property></widget></item>
      <item row="0" column="1">
       <widget class="QComboBox" name="treeSideComboBox">
        <property name="toolTip"><string>Same setting as View → Collection Tree Position.</string></property>
        <item><property name="text"><string>Left</string></property></item>
        <item><property name="text"><string>Right</string></property></item>
       </widget>
      </item>
      <item row="1" column="0"><widget class="QLabel" name="treeModeLabel"><property name="text"><string>Mode:</string></property></widget></item>
      <item row="1" column="1">
       <widget class="QComboBox" name="treeModeComboBox">
        <property name="toolTip"><string>Overlap floats the navigation sidebar above the content, so opening or resizing it never moves the grid underneath — it simply covers it. Push aside keeps the classic behaviour, where the sidebar takes its width from the content area and the grid shifts to make room.</string></property>
        <item><property name="text"><string>Overlap the content</string></property></item>
        <item><property name="text"><string>Push the content aside</string></property></item>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel" name="treeJustificationLabel"><property name="text"><string>Justification:</string></property></widget></item>
      <item row="2" column="1">
       <widget class="QComboBox" name="treeJustificationComboBox">
        <property name="toolTip"><string>Full height makes the tree span the whole window, with the toolbar stopping at its edge.</string></property>
        <item><property name="text"><string>Below toolbar</string></property></item>
        <item><property name="text"><string>Full height</string></property></item>
       </widget>
      </item>
      <item row="3" column="0"><widget class="QLabel" name="treeWidthLabel"><property name="text"><string>Width:</string></property></widget></item><item row="3" column="1"><widget class="QSpinBox" name="treeWidthSpinBox"><property name="toolTip"><string>Width of the navigation sidebar in pixels. You can also drag the panel&apos;s inner edge.</string></property><property name="minimum"><number>140</number></property><property name="maximum"><number>600</number></property><property name="value"><number>240</number></property><property name="suffix"><string> px</string></property></widget></item><item row="4" column="0"><widget class="QLabel" name="treeHideScrollbarLabel"><property name="text"><string>Scrollbar:</string></property></widget></item>
      <item row="4" column="1">
       <widget class="QComboBox" name="treeScrollbarModeComboBox"><property name="toolTip"><string>Show: normal. Auto-hide: appears only when the pointer comes near the scrollbar edge. Hide: never drawn. The tree always scrolls with the wheel and the arrow keys — this only governs the indicator. Auto-hide needs slim overlay scrollbars (Settings -&gt; General); without them it behaves as Show.</string></property><item><property name="text"><string>Show</string></property></item><item><property name="text"><string>Auto-hide (show near the edge)</string></property></item><item><property name="text"><string>Hide</string></property></item></widget>
      </item>
      <item row="5" column="0"><widget class="QLabel" name="treeIconDisplayLabel"><property name="text"><string>Rows show:</string></property></widget></item>
      <item row="5" column="1">
       <widget class="QComboBox" name="treeIconDisplayComboBox">
        <property name="toolTip"><string>What a row shows when it has an icon or logo. Name only: the artwork is kept but not drawn. Icon and name: a small icon beside the name. Icon only: just the artwork, with the name in the tooltip. Rows without artwork always show their name.</string></property>
        <item><property name="text"><string>Name only</string></property></item>
        <item><property name="text"><string>Icon and name</string></property></item>
        <item><property name="text"><string>Icon only (name in tooltip)</string></property></item>
       </widget>
      </item>
      <item row="6" column="0"><widget class="QLabel" name="treeShowLinesLabel"><property name="text"><string>Tree lines:</string></property></widget></item>
      <item row="6" column="1">
       <widget class="QCheckBox" name="treeShowLinesCheckBox">
        <property name="toolTip"><string>Draw the connector lines between branches. The expand/collapse chevrons show either way.</string></property>
        <property name="text"><string>Show branch connector lines</string></property>
       </widget>
      </item>
      <item row="7" column="0"><widget class="QLabel" name="treeIconSizeLabel"><property name="text"><string>Icon height:</string></property></widget></item>
      <item row="7" column="1">
       <widget class="QSpinBox" name="treeIconSizeSpinBox">
        <property name="toolTip"><string>Height of the row icons/logos in pixels. Width follows the panel width, keeping each logo's aspect ratio.</string></property>
        <property name="minimum"><number>12</number></property>
        <property name="maximum"><number>512</number></property>
        <property name="value"><number>16</number></property>
        <property name="suffix"><string> px</string></property>
       </widget>
      </item>
      <item row="8" column="0"><widget class="QLabel" name="treeIconStyleLabel"><property name="text"><string>Icon style:</string></property></widget></item>
      <item row="8" column="1">
       <widget class="QComboBox" name="treeIconStyleComboBox">
        <property name="toolTip"><string>Normal shows the artwork as-is. Monochrome recolours the logo's silhouette in a fixed dark or light ink. Tinted recolours it with the tint colour below.</string></property>
        <item><property name="text"><string>Normal</string></property></item>
        <item><property name="text"><string>Monochrome dark</string></property></item>
        <item><property name="text"><string>Monochrome light</string></property></item>
        <item><property name="text"><string>Tinted</string></property></item>
       </widget>
      </item>
      <item row="10" column="0"><widget class="QLabel" name="treeColorizeSelectedLabel"><property name="text"><string>Active logo:</string></property></widget></item>
      <item row="10" column="1">
       <widget class="QCheckBox" name="treeColorizeSelectedCheckBox">
        <property name="toolTip"><string>With a monochrome or tinted style, show the collection you are currently viewing in its original colours. No effect on the Normal style.</string></property>
        <property name="text"><string>Show the active collection's logo in colour</string></property>
       </widget>
      </item>
      <item row="11" column="0"><widget class="QLabel" name="treeScrollClippedLabelsLabel"><property name="text"><string>Long names:</string></property></widget></item>
      <item row="11" column="1">
       <widget class="QCheckBox" name="treeScrollClippedLabelsCheckBox">
        <property name="toolTip"><string>When a collection's name is too long for the panel, scroll it sideways so the whole name can be read. Names that already fit never move.</string></property>
        <property name="text"><string>Scroll names that do not fit</string></property>
       </widget>
      </item>
      <item row="12" column="1">
       <widget class="QCheckBox" name="treeScrollClippedLabelsOnHoverCheckBox">
        <property name="toolTip"><string>Scroll a name that does not fit while the pointer is over its row, then put it back when the pointer leaves. Only the row you are pointing at moves.</string></property>
        <property name="text"><string>Scroll the row under the pointer</string></property>
       </widget>
      </item>
      <item row="9" column="0"><widget class="QLabel" name="treeIconTintLabel"><property name="text"><string>Tint colour:</string></property></widget></item>
      <item row="9" column="1">
       <widget class="QLineEdit" name="treeIconTintEdit">
        <property name="toolTip"><string>Hex colour (e.g. #e0a030) used by the Tinted style. Leave empty to use the collection's accent colour.</string></property>
        <property name="placeholderText"><string>Accent colour (default)</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="systemIconGroup">
     <property name="title"><string>System Icon (from RetroArch)</string></property>
     <layout class="QFormLayout" name="systemIconForm">
      <item row="0" column="1">
       <widget class="QCheckBox" name="systemIconEnabledCheckBox">
        <property name="toolTip"><string>Draw a small console, controller or cartridge icon to the left of this collection's name in the navigation sidebar. The icons come from your local RetroArch installation.</string></property>
        <property name="text"><string>Show an icon beside this collection's name</string></property>
       </widget>
      </item>
      <item row="1" column="0"><widget class="QLabel" name="systemIconSubjectLabel"><property name="text"><string>Show:</string></property></widget></item>
      <item row="1" column="1">
       <widget class="QComboBox" name="systemIconSubjectComboBox">
        <property name="toolTip"><string>What the icon depicts. Controller and Console come from different RetroArch icon sets; Cartridge / disc is the media icon that ships alongside each system.</string></property>
        <item><property name="text"><string>Controller</string></property></item>
        <item><property name="text"><string>Console</string></property></item>
        <item><property name="text"><string>Cartridge / disc</string></property></item>
       </widget>
      </item>
      <item row="2" column="0"><widget class="QLabel" name="systemIconSystemLabel"><property name="text"><string>System:</string></property></widget></item>
      <item row="2" column="1">
       <layout class="QHBoxLayout" name="systemIconSystemRow">
        <item>
         <widget class="QComboBox" name="systemIconSystemComboBox">
          <property name="editable"><bool>true</bool></property>
          <property name="toolTip"><string>Which system's icon to show. Type to search.</string></property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="systemIconDetectButton">
          <property name="toolTip"><string>Guess the system from this collection's name.</string></property>
          <property name="text"><string>Detect</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="3" column="0"><widget class="QLabel" name="systemIconPackLabel"><property name="text"><string>Icon set:</string></property></widget></item>
      <item row="3" column="1">
       <widget class="QComboBox" name="systemIconPackComboBox">
        <property name="toolTip"><string>Which RetroArch icon set to take the icon from. Automatic picks one to match the style above. Sets cover different numbers of systems — one that does not cover this system shows no icon.</string></property>
       </widget>
      </item>
      <item row="4" column="0"><widget class="QLabel" name="systemIconStyleLabel"><property name="text"><string>Icon style:</string></property></widget></item>
      <item row="4" column="1">
       <widget class="QComboBox" name="systemIconStyleComboBox">
        <property name="toolTip"><string>How the icon is coloured. Normal leaves it in its own colours. Monochrome inks it in a fixed dark or light shade. Tinted inks it with the navigation sidebar's tint colour. Applies to system icons and collection artwork alike, so a manufacturer logo matches the platform icons beneath it.</string></property>
        <item><property name="text"><string>Normal</string></property></item>
        <item><property name="text"><string>Monochrome (dark)</string></property></item>
        <item><property name="text"><string>Monochrome (light)</string></property></item>
        <item><property name="text"><string>Tinted</string></property></item>
       </widget>
      </item>
      <item row="5" column="0"><widget class="QLabel" name="systemIconPlacementLabel"><property name="text"><string>Position:</string></property></widget></item>
      <item row="5" column="1">
       <widget class="QComboBox" name="systemIconPlacementComboBox">
        <property name="toolTip"><string>Where the icon sits. Before and after the name keep the icon next to the text, so it moves with it. At the panel edge pins every icon to the right-hand edge instead, lining them up in a column whatever the names are.</string></property>
        <item><property name="text"><string>Before the name</string></property></item>
        <item><property name="text"><string>After the name</string></property></item>
        <item><property name="text"><string>At the panel edge</string></property></item>
       </widget>
      </item>
      <item row="6" column="0"><widget class="QLabel" name="systemIconSizeLabel"><property name="text"><string>Icon height:</string></property></widget></item>
      <item row="6" column="1">
       <widget class="QSpinBox" name="systemIconSizeSpinBox">
        <property name="toolTip"><string>Height of the icon in pixels. This is the small icon beside the name, not the row artwork above.</string></property>
        <property name="minimum"><number>8</number></property>
        <property name="maximum"><number>64</number></property>
        <property name="value"><number>16</number></property>
        <property name="suffix"><string> px</string></property>
       </widget>
      </item>
      <item row="7" column="1">
       <widget class="QLabel" name="systemIconStatusLabel">
        <property name="wordWrap"><bool>true</bool></property>
        <property name="text"><string/></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
