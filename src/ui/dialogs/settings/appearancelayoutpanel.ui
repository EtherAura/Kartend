   <item>
    <widget class="QGroupBox" name="appearanceViewGroupBox">
     <property name="title"><string>View</string></property>
     <!-- Three label/field pairs share one row (three-column section);
          field columns are stretched in code so the pairs fill the width. -->
     <layout class="QGridLayout" name="appearanceViewGridLayout">
      <property name="horizontalSpacing"><number>16</number></property>
      <property name="verticalSpacing"><number>6</number></property>
      <item row="0" column="0"><widget class="QLabel" name="label_viewType"><property name="text"><string>View Type:</string></property></widget></item>
      <item row="0" column="1">
       <widget class="QComboBox" name="viewTypeComboBox">
        <property name="minimumWidth"><number>140</number></property>
        <property name="toolTip"><string>Display items as a grid with artwork, a simple list, a 3D cover-flow carousel, or a horizontally-scrolling grid</string></property>
        <item><property name="text"><string>Grid</string></property></item>
        <item><property name="text"><string>List</string></property></item>
        <item><property name="text"><string>Cover Flow</string></property></item>
        <item><property name="text"><string>Horizontal</string></property></item>
       </widget>
      </item>
      <item row="0" column="2"><widget class="QLabel" name="label_horizontalAlignment"><property name="text"><string>Alignment:</string></property></widget></item>
      <item row="0" column="3">
       <widget class="QComboBox" name="horizontalAlignmentComboBox">
        <property name="minimumWidth"><number>140</number></property>
        <property name="toolTip"><string>Horizontal alignment of collection grid (Left, Center, Right)</string></property>
        <item><property name="text"><string>Left</string></property></item>
        <item><property name="text"><string>Center</string></property></item>
        <item><property name="text"><string>Right</string></property></item>
       </widget>
      </item>
      <item row="0" column="5"><widget class="QCheckBox" name="hideMissingArtworkCheckBox"><property name="text"><string>Hide items without artwork</string></property><property name="toolTip"><string>When enabled, media items whose artwork lookup returns no match are hidden from the items page. Subcollections and virtual folders are unaffected.</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="appearanceGridSizingGroupBox">
     <property name="title"><string>Grid Sizing</string></property>
     <!-- Two value/alternate pairs share one row (two-column section). -->
     <layout class="QGridLayout" name="appearanceGridSizingGridLayout">
      <property name="horizontalSpacing"><number>16</number></property>
      <property name="verticalSpacing"><number>6</number></property>
      <item row="0" column="0"><widget class="QLabel" name="label_gridLayout"><property name="text"><string>Grid Width:</string></property></widget></item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="gridWidthLayout">
        <item><widget class="QSpinBox" name="gridWidthSpinBox"><property name="maximumWidth"><number>100</number></property><property name="toolTip"><string>Number of artwork items per row (no upper cap)</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>2147483647</number></property><property name="value"><number>4</number></property></widget></item>
        <item><widget class="QLabel" name="label_gridWidthSidebarHidden"><property name="text"><string>/ pane hidden:</string></property><property name="toolTip"><string>Alternate items-per-row used when the details pane is hidden in Expand mode. 0 inherits Grid Width. (Overlay mode always uses Grid Width — the floating pane doesn't shrink the grid.)</string></property></widget></item>
        <item><widget class="QSpinBox" name="gridWidthSidebarHiddenSpinBox"><property name="maximumWidth"><number>100</number></property><property name="toolTip"><string>Items-per-row when the details pane is hidden in Expand mode (no upper cap). 0 falls back to Grid Width.</string></property><property name="specialValueText"><string>auto</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>2147483647</number></property><property name="value"><number>0</number></property></widget></item>
        <item><spacer name="gridWidthSpacer"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property></spacer></item>
       </layout>
      </item>
      <item row="0" column="2"><widget class="QLabel" name="label_horizontalGridHeight"><property name="text"><string>Horizontal Height:</string></property><property name="toolTip"><string>Items per column when the view type is set to Horizontal. 0 inherits Grid Width.</string></property></widget></item>
      <item row="0" column="3">
       <layout class="QHBoxLayout" name="horizontalGridHeightLayout">
        <item><widget class="QSpinBox" name="horizontalGridHeightSpinBox"><property name="maximumWidth"><number>100</number></property><property name="toolTip"><string>Items per column for Horizontal view (no upper cap). 0 falls back to Grid Width.</string></property><property name="specialValueText"><string>auto</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>2147483647</number></property><property name="value"><number>0</number></property></widget></item>
        <item><widget class="QLabel" name="label_horizontalGridHeightSidebarHidden"><property name="text"><string>/ pane hidden:</string></property><property name="toolTip"><string>Alternate items-per-column for Horizontal view when the details pane is hidden in Expand mode. 0 inherits Horizontal Height.</string></property></widget></item>
        <item><widget class="QSpinBox" name="horizontalGridHeightSidebarHiddenSpinBox"><property name="maximumWidth"><number>100</number></property><property name="toolTip"><string>Items per column for Horizontal view when the details pane is hidden in Expand mode (no upper cap). 0 falls back to Horizontal Height.</string></property><property name="specialValueText"><string>auto</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>2147483647</number></property><property name="value"><number>0</number></property></widget></item>
        <item><spacer name="horizontalGridHeightSpacer"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property></spacer></item>
