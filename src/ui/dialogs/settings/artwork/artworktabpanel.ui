      <item row="1" column="1"><widget class="QLineEdit" name="customArtworkTypesLineEdit"><property name="maximumWidth"><number>320</number></property><property name="toolTip"><string>Comma-separated list of user-defined artwork type ids beyond the standard set (box, screenshot, title, marquee, fanart, logo). Custom types only resolve via per-item manual links from the sidebar — they are NOT auto-discovered from artwork subdirectories.</string></property><property name="placeholderText"><string>e.g. cabinet, flyer, character_select</string></property></widget></item>
