      <item row="2" column="1">
       <layout class="QHBoxLayout" name="manualDirLayout">
        <item><widget class="QLineEdit" name="manualDirLineEdit"><property name="toolTip"><string>Directory containing per-item manual files (PDF, EPUB, TXT, etc.). Files are matched by base name (e.g. SuperMario.pdf for SuperMario.smc). Per-item overrides can be set via the right-click menu.</string></property></widget></item>
        <item><widget class="QPushButton" name="browseManualDirButton"><property name="text"><string>Browse</string></property></widget></item>
