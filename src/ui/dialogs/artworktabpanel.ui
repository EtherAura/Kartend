       <layout class="QHBoxLayout" name="videoDirLayout">
        <item><widget class="QLineEdit" name="videoDirLineEdit"><property name="toolTip"><string>Directory containing per-item preview videos. Files are matched by base name (e.g. SuperMario.mp4 for SuperMario.smc).</string></property></widget></item>
