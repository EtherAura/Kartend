          </layout>
         </widget>
         <!-- Subfolders Tab -->
         <widget class="QWidget" name="subfoldersTab">
          <attribute name="title">
           <string>Subfolders</string>
          </attribute>
          <layout class="QVBoxLayout" name="subfoldersTabLayout">
           <item>
            <layout class="QFormLayout" name="subfoldersFormLayout">
             <item row="0" column="0">
              <widget class="QLabel" name="label_contentSubfolders">
               <property name="text">
                <string>Content Subfolders:</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <layout class="QVBoxLayout" name="contentSubfoldersLayout">
               <property name="spacing">
                <number>4</number>
               </property>
               <item>
                <layout class="QHBoxLayout" name="contentOptionsLayout">
                 <item>
                  <widget class="QCheckBox" name="includeContentSubfoldersCheckBox">
                   <property name="toolTip">
                    <string>Show subfolders as navigable virtual folders (does not create subcollections)</string>
                   </property>
                   <property name="text">
                    <string>Include Subfolders</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <spacer name="contentOptionsSpacer">
                   <property name="orientation">
                    <enum>Qt::Orientation::Horizontal</enum>
                   </property>
                   <property name="sizeHint" stdset="0">
                    <size>
                     <width>40</width>
                     <height>20</height>
                    </size>
                   </property>
                  </spacer>
                 </item>
                </layout>
               </item>
               <item>
                <widget class="QWidget" name="subfolderOptionsWidget">
                 <layout class="QHBoxLayout" name="subfolderOptionsLayout">
                  <property name="leftMargin">
                   <number>20</number>
                  </property>
                  <property name="topMargin">
                   <number>0</number>
                  </property>
                  <property name="bottomMargin">
                   <number>0</number>
                  </property>
                  <item>
                   <widget class="QCheckBox" name="showAllSubfolderItemsCheckBox">
                    <property name="toolTip">
                     <string>Mix items from subfolders with parent collection items, sorted alphabetically</string>
                    </property>
                    <property name="text">
                     <string>Show All Items</string>
                    </property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QCheckBox" name="hideSubfolderTitlesCheckBox">
                    <property name="toolTip">
                     <string>Hide titles on virtual subfolder widgets</string>
                    </property>
                    <property name="text">
                     <string>Hide Titles</string>
                    </property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QCheckBox" name="showHiddenFoldersCheckBox">
                    <property name="toolTip">
                     <string>Show hidden folders (folders starting with a dot)</string>
                    </property>
                    <property name="text">
                     <string>Show Hidden</string>
                    </property>
                   </widget>
                  </item>
                  <item>
                   <spacer name="subfolderOptionsSpacer">
                    <property name="orientation">
                     <enum>Qt::Orientation::Horizontal</enum>
                    </property>
                    <property name="sizeHint" stdset="0">
                     <size>
                      <width>40</width>
                      <height>20</height>
                     </size>
                    </property>
                   </spacer>
                  </item>
                 </layout>
                </widget>
               </item>
              </layout>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="label_artworkSubfolders">
               <property name="text">
                <string>Artwork Subfolders:</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QCheckBox" name="includeArtworkSubfoldersCheckBox">
               <property name="toolTip">
                <string>Look for artwork in subfolders matching the content structure</string>
               </property>
               <property name="text">
                <string>Include Subfolders</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <spacer name="subfoldersVerticalSpacer">
             <property name="orientation">
              <enum>Qt::Orientation::Vertical</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>20</width>
               <height>40</height>
              </size>
             </property>
            </spacer>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- Sidebar Tab (Kartend-b57): top-level category. Settings are
          per-collection — the row below shows which collection is being
          edited (driven by the Collections tab tree selection). -->
     <widget class="QWidget" name="sidebarTab">
      <attribute name="title">
       <string>Sidebar</string>
      </attribute>
      <layout class="QVBoxLayout" name="sidebarTabLayout">
       <item>
        <widget class="QLabel" name="sidebarActiveCollectionLabel">
         <property name="text">
          <string>Editing: (no collection selected)</string>
         </property>
         <property name="toolTip">
          <string>These settings apply to the collection selected in the Collections tab.</string>
         </property>
         <property name="styleSheet">
          <string>QLabel { font-style: italic; color: palette(mid); }</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QFormLayout" name="sidebarFormLayout">
         <item row="0" column="0">
          <widget class="QLabel" name="label_sidebarMode">
           <property name="text">
            <string>Sidebar Mode:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QComboBox" name="sidebarModeComboBox">
           <property name="toolTip">
            <string>Choose how the sidebar is displayed</string>
           </property>
           <item>
            <property name="text">
             <string>Overlay</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Fixed</string>
            </property>
           </item>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="label_scrollbars">
           <property name="text">
            <string>Scrollbars:</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <layout class="QHBoxLayout" name="scrollbarsLayout">
           <item>
            <widget class="QCheckBox" name="hideHorizontalScrollbarCheckBox">
             <property name="toolTip"><string>Hide the horizontal scrollbar for this collection</string></property>
             <property name="text"><string>Hide Horizontal</string></property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="hideVerticalScrollbarCheckBox">
             <property name="toolTip"><string>Hide the vertical scrollbar for this collection</string></property>
             <property name="text"><string>Hide Vertical</string></property>
            </widget>
           </item>
