                   </widget>
                  </item>
                  <item row="0" column="1">
                   <layout class="QHBoxLayout" name="wallpaperParallaxLayout">
                    <item>
                     <widget class="QCheckBox" name="wallpaperParallaxCheckBox">
                      <property name="text"><string>Enable</string></property>
                      <property name="toolTip"><string>Tie the image background's vertical position to the items scroll offset. Image bg only — video bgs are unaffected.</string></property>
                     </widget>
                    </item>
                    <item>
                     <widget class="QLabel" name="label_parallaxStrength">
                      <property name="text"><string>Strength:</string></property>
                     </widget>
                    </item>
                    <item>
                     <widget class="QSpinBox" name="parallaxStrengthSpinBox">
                      <property name="minimumWidth"><number>110</number></property>
                      <property name="toolTip"><string>0 = bg locked (no parallax movement); 100 = bg moves in lockstep with content. 30 is a subtle default.</string></property>
                      <property name="minimum"><number>0</number></property>
                      <property name="maximum"><number>100</number></property>
                      <property name="value"><number>30</number></property>
                     </widget>
                    </item>
                   </layout>
                  </item>
                 </layout>
                </widget>
               </item>
               <item>
                <widget class="QGroupBox" name="appearanceToolbarBlurGroupBox">
                 <property name="title"><string>Toolbar Blur</string></property>
                 <layout class="QFormLayout" name="appearanceEffectsFormLayout">
                  <property name="horizontalSpacing"><number>8</number></property>
                  <property name="verticalSpacing"><number>6</number></property>
                  <property name="fieldGrowthPolicy"><enum>QFormLayout::FieldGrowthPolicy::ExpandingFieldsGrow</enum></property>
                  <item row="0" column="0">
                   <widget class="QLabel" name="label_toolbarBackdropBlur">
                    <property name="text"><string>Toolbar Blur:</string></property>
                   </widget>
                  </item>
                  <item row="0" column="1">
                   <layout class="QHBoxLayout" name="toolbarBackdropBlurLayout">
                    <item>
                     <widget class="QCheckBox" name="toolbarBackdropBlurCheckBox">
                      <property name="text"><string>Enable</string></property>
                      <property name="toolTip"><string>Use a blurred copy of the wallpaper as the toolbar background, mimicking macOS Vibrancy. Image bg only — no-op while a video bg is active.</string></property>
                     </widget>
                    </item>
                    <item>
                     <widget class="QLabel" name="label_backdropBlurRadius">
                      <property name="text"><string>Radius:</string></property>
                     </widget>
                    </item>
                    <item>
                     <widget class="QSpinBox" name="backdropBlurRadiusSpinBox">
                      <property name="minimumWidth"><number>110</number></property>
                      <property name="toolTip"><string>Blur radius (4 = barely perceptible; 32 = source becomes unreadable).</string></property>
                      <property name="minimum"><number>4</number></property>
                      <property name="maximum"><number>32</number></property>
                      <property name="value"><number>12</number></property>
                     </widget>
                    </item>
                   </layout>
                  </item>
                 </layout>
                </widget>
               </item>
               <item><spacer name="appearanceEffectsVerticalSpacer"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>4</height></size></property></spacer></item>
              </layout>
             </widget>
            </widget>
           </item>
          </layout>
         </widget>
         <!-- Subfolders Tab -->
         <widget class="QWidget" name="subfoldersTab">
          <attribute name="title">
           <string>Subfolders</string>
          </attribute>
          <layout class="QVBoxLayout" name="subfoldersTabLayout">
           <item>
            <widget class="SubfoldersPanel" name="subfoldersPanel" native="true"/>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- Details-pane Tab: top-level category.
          Settings are per-collection — the row below shows which collection
          is being edited (driven by the Collections tab tree selection). -->
     <widget class="QWidget" name="sidebarTab">
      <attribute name="icon">
       <iconset theme="format-justify-right"/>
      </attribute>
      <attribute name="title">
       <string>Details Pane</string>
      </attribute>
      <layout class="QVBoxLayout" name="sidebarTabLayout">
       <item>
        <widget class="SidebarPanel" name="sidebarPanel" native="true"/>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="launchersTab">
      <attribute name="icon">
       <iconset theme="system-run"/>
      </attribute>
      <attribute name="title">
       <string>Launchers</string>
      </attribute>
      <layout class="QVBoxLayout" name="launchersTabLayout">
       <item>
        <widget class="LauncherPresetsPanel" name="launcherPresetsPanel" native="true"/>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="generalTab">
      <attribute name="icon">
       <iconset theme="document-properties"/>
      </attribute>
      <attribute name="title">
       <string>General</string>
      </attribute>
      <layout class="QVBoxLayout" name="generalTabLayout">
       <item>
                <widget class="QTabWidget" name="generalSubTabWidget">
                 <property name="currentIndex">
                    <number>0</number>
                 </property>
                 <widget class="QWidget" name="generalSettingsSubTab">
                    <attribute name="title">
                     <string>General</string>
                    </attribute>
                    <layout class="QVBoxLayout" name="generalSettingsSubTabLayout">
           <item>
            <widget class="GeneralSettingsPanel" name="generalSettingsPanel" native="true"/>
           </item>
           <item>
            <widget class="QGroupBox" name="backupGroupBox">
             <property name="title">
              <string>Configuration Backup</string>
             </property>
             <layout class="QVBoxLayout" name="backupContentLayout">
              <item>
               <widget class="QLabel" name="backupDescriptionLabel">
                <property name="wordWrap">
                 <bool>true</bool>
                </property>
                <property name="text">
                 <string>Export your full Kartend configuration (general settings, all collections, and launcher presets) to a .cfg file in the config directory, or load a previously exported file. Loading replaces the active configuration; the previous one is preserved as kartend.cfg.bak.</string>
                </property>
               </widget>
              </item>
              <item>
               <layout class="QHBoxLayout" name="backupExportLayout">
                <item>
                 <widget class="QPushButton" name="exportConfigButton">
                  <property name="toolTip">
                   <string>Save the current Kartend configuration to a named .cfg file in the config directory</string>
                  </property>
                  <property name="text">
                   <string>Export...</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <spacer name="backupExportSpacer">
                  <property name="orientation">
                   <enum>Qt::Orientation::Horizontal</enum>
                  </property>
                  <property name="sizeHint" stdset="0">
                   <size>
                    <width>40</width>
                    <height>20</height>
                   </size>
                  </property>
                 </spacer>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout" name="backupImportLayout">
                <item>
                 <widget class="QLabel" name="importConfigLabel">
                  <property name="text">
                   <string>Load profile:</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QComboBox" name="importConfigComboBox">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>.cfg files found in the Kartend config directory. The currently active config is marked with "(active)".</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="importConfigButton">
                  <property name="toolTip">
                   <string>Replace the active configuration with the selected profile (requires restart)</string>
                  </property>
                  <property name="text">
                   <string>Load</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="splashSubTab">
          <attribute name="title">
           <string>Splash</string>
          </attribute>
          <layout class="QVBoxLayout" name="splashSubTabLayout">
           <item>
            <widget class="SplashPanel" name="splashPanel" native="true"/>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="fontsSubTab">
          <attribute name="title">
           <string>Fonts</string>
          </attribute>
          <layout class="QVBoxLayout" name="fontsSubTabLayout">
           <item>
            <widget class="FontsPanel" name="fontsPanel" native="true"/>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="attractSubTab">
          <attribute name="title">
           <string>Attract Mode</string>
          </attribute>
          <layout class="QVBoxLayout" name="attractSubTabLayout">
           <item>
            <widget class="AttractPanel" name="attractPanel" native="true"/>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="toolbarSubTab">
          <attribute name="title">
           <string>Toolbar Buttons</string>
          </attribute>
          <layout class="QVBoxLayout" name="toolbarSubTabLayout">
           <item>
            <widget class="ToolbarPanel" name="toolbarPanel" native="true"/>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="controlsSubTab">
          <attribute name="title">
           <string>Controls</string>
          </attribute>
          <layout class="QVBoxLayout" name="controlsSubTabLayout">
           <item>
            <widget class="ControlsPanel" name="controlsPanel" native="true"/>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Orientation::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Orientation::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
