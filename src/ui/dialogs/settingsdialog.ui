               <item>
                <widget class="QGroupBox" name="appearanceViewGroupBox">
                 <property name="title"><string>View</string></property>
                 <layout class="QFormLayout" name="appearanceViewFormLayout">
                  <property name="horizontalSpacing"><number>8</number></property>
                  <property name="verticalSpacing"><number>6</number></property>
