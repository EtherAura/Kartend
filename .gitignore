build/
build-*/
/Testing/
*.tar.gz

# Local code-review scratch output (e.g. `/code-review --comment` writes a
# review-body.md at the repo root). Not shared — it's a per-run artifact.
/review-body.md

*.o
*.a
*.so
*.dylib
*.dll
.DS_Store
.vscode/*
# Kartend-zvh0: ship a curated launch + tasks set so 'F5 to debug' works
# without per-developer setup. Other .vscode entries (settings.json with
# user-specific clang paths, mcp.json with API-key prompts) stay
# gitignored as personal config.
!.vscode/launch.json
!.vscode/tasks.json

# Defensive: catch in-source CMake artifacts if a `cmake -B .` ever runs
# from the source root by accident. The /build entry above only protects
# the canonical out-of-tree dir; without these patterns dozens of stray
# Makefile / CMakeFiles/ directories scatter through src/.
CMakeCache.txt
/CMakeFiles/
/Makefile
/cmake_install.cmake
/CTestTestfile.cmake
/CPackConfig.cmake
/CPackSourceConfig.cmake
/install_manifest.txt
src/**/CMakeFiles/
src/**/cmake_install.cmake
src/**/CTestTestfile.cmake
src/**/Makefile
tests/**/CMakeFiles/
tests/**/cmake_install.cmake
tests/**/CTestTestfile.cmake
tests/**/Makefile

# Qt autogen artifacts (only land here if cmake configures in-tree)
.qt/
*_autogen/

# Qt Linguist build artifacts: *.qm are compiled translations (built from
# the tracked translations/*.ts sources); .lupdate/ is lupdate's scan cache.
*.qm
.lupdate/

# IDE files
*.user
*.swp
*.swo
*~
.idea/
.cache/

# Qt Creator
CMakeLists.txt.user*

# Python bytecode (e.g. .scripts/ helpers)
__pycache__/
*.pyc

# Python virtualenvs (canonical path is .scripts/.venv/; .scripts/venv/ is
# the legacy path some setups still use). Both also self-protect via the
# inner .gitignore Python writes inside the venv directory, but listing
# them here is defense in depth.
.venv/
venv/

# Logs and crash dumps
*.log
/core
/core.*

# Screenshots dropped at repo root by KDE/GNOME tools — never repo content.
/Screenshot*.png
/Screenshot*.jpg
/Screenshot*.webp

# Root compile_commands.json (CMake export sometimes mirrored here)
/compile_commands.json

# Per-developer agent / editor state
.claude/

# AI-agent instruction files — kept local, not shared with the repo
/CLAUDE.md
/AGENTS.md
/.github/copilot-instructions.md

# Manual runtime-verification checklists — ephemeral working notes
# ("work through it, then delete"), never meant to be tracked.
/MANUAL_VERIFICATION-*.md

# Obsidian vault metadata (personal note-taking, not project state)
.obsidian/

# Beads — local-only issue tracker; the whole dir is untracked (bd still
# uses it on disk, it's just not shared via git).
# .beads internals are excluded by .beads/.gitignore; issues.jsonl/config/metadata ARE tracked (g6p)
.dolt/
*.db
.beads-credential-key

# graphify knowledge graph artifacts (generated)
graphify-out/
.graphify/

# bd (beads) issue tracker: local-only — full-fidelity data lives in the
# Dolt DB with its own sync; issue metadata and timestamps must not be
# mirrored to the public repo (owner decision, 2026-06-12).
.beads/
