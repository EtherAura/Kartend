build/
/Testing/
*.tar.gz
*.o
*.a
*.so
*.dylib
*.dll
.DS_Store
.vscode/

# Defensive: catch in-source CMake artifacts if a `cmake -B .` ever runs
# from the source root by accident. The /build entry above only protects
# the canonical out-of-tree dir; without these patterns dozens of stray
# Makefile / CMakeFiles/ directories scatter through src/.
CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/CTestTestfile.cmake
/CPackConfig.cmake
/CPackSourceConfig.cmake
/install_manifest.txt
src/**/CMakeFiles/
src/**/cmake_install.cmake
src/**/CTestTestfile.cmake
src/**/Makefile
tests/**/CMakeFiles/
tests/**/cmake_install.cmake
tests/**/CTestTestfile.cmake
tests/**/Makefile

# Qt autogen artifacts (only land here if cmake configures in-tree)
.qt/
*_autogen/

# IDE files
*.user
*.swp
*.swo
*~
.idea/
.cache/

# Qt Creator
CMakeLists.txt.user*

# Python bytecode (e.g. .scripts/ helpers)
__pycache__/
*.pyc

# Logs and crash dumps
*.log
/core
/core.*

# Root compile_commands.json (CMake export sometimes mirrored here)
/compile_commands.json

# Per-developer agent / editor state
.claude/

# Obsidian vault metadata (personal note-taking, not project state)
.obsidian/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
